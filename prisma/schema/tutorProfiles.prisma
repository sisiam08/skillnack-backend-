enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model TutorProfiles {
  id                      String             @id @default(uuid())
  userId                  String             @unique
  categoriesId            String?
  bio                     String?            @db.VarChar(255)
  hourlyRate              Float              @default(0.00)
  experienceYears         Float
  tags                    String[]           @db.VarChar(255)
  headline                String?            @db.VarChar(100)
  currentRoleOrInstitution String?
  linkedinUrl             String?
  githubUrl               String?
  portfolioUrl            String?
  verificationStatus      VerificationStatus @default(PENDING)
  rejectionReason         String?
  totalRating             Int                @default(0)
  totalReviews            Int                @default(0)
  totalCompletedBookings  Int                @default(0)
  solvedCount             Int                @default(0)
  totalOutcomesRecorded   Int                @default(0)
  defaultClassLink        String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  bookings               Bookings[]
  availability           TutorAvailability[]
  category               Categories?         @relation(fields: [categoriesId], references: [id])
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects               Subject[]
  skills                 Skill[]

  @@index([userId])
  @@index([verificationStatus, categoriesId])
  @@index([hourlyRate])
  @@index([totalRating])
  @@map("tutorProfiles")
}
