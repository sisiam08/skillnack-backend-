enum BookingStatus {
  PENDING
  CONFIRMED
  RUNNING
  COMPLETED
  CANCELLED
}

model Bookings {
  id            String        @id @default(uuid())
  studentId     String
  tutorId       String
  sessionDate   DateTime
  startTime     String
  endTime       String
  price         Float
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  classLink     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor         TutorProfiles @relation(fields: [tutorId], references: [id])
  reviews       Reviews?
  payment       Payment?

  @@index([id])
  @@map("bookings")
}
