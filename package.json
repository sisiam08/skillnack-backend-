{
  "name": "backend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsup src/server.ts --format esm --outDir dist",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/pg": "^8.11.0",
    "prisma": "^7.7.0",
    "tsx": "^4.21.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.0",
    "better-auth": "^1.6.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "stripe": "^22.0.2",
    "uuid": "^13.0.0"
  }
}