{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "EsNext",
    "target": "ES2023",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}